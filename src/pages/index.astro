---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import KnowledgeCard from '../components/KnowledgeCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('knowledge', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const services = [
  {
    number: '01',
    title: 'Data & AI Strategy',
    description:
      "Frame the right problem before touching code. I help you identify what you actually need—whether that's a searchable archive, an AI assistant, or a cleaner dataset—and sketch the smallest useful solution.",
    tags: ['Information architecture', 'AI agent design', 'Problem framing'],
    href: '/services#strategy',
  },
  {
    number: '02',
    title: 'Agentic Workflows & AI Assistants',
    description:
      'AI that acts, not just answers. I design AI agents and dynamic workflows—using frameworks like Hermes—that carry out multi-step business processes, with human checkpoints where they count.',
    tags: ['Agentic frameworks', 'Dynamic workflows', 'Human-in-the-loop'],
    href: '/services#agents',
  },
  {
    number: '03',
    title: 'Dashboards & Decision Tools',
    description:
      'Design of  dashboards built around actual questions so answers are at your fingertips.',
    tags: ['Data visualization', 'Grants & programs', 'Visual reporting'],
    href: '/services#dashboards',
  },
  {
    number: '04',
    title: 'Automation & Data Engineering',
    description:
      'Reduce copy-paste and disarticulated data. Supported with AI-driven automation with human-validated control gates so you save time without losing oversight.',
    tags: ['Workflow automation', 'Data cleanup', 'Integrations'],
    href: '/services#automation',
  },
  {
    number: '05',
    title: 'Connected Web Presence',
    description:
      'Your website as a live data application and not a static brochure. Forms that write to your systems, user search that answers real questions, and AI-enhanced features grounded in your own content.',
    tags: ['Modern Web Frameworks', 'Semantic search', 'Content architecture'],
    href: '/services#web',
  },
];
---

<Layout
  title="AiCraft — AI-Powered Data Solutions for Small Organizations"
  description="AiCraft builds intelligence-grade AI, data, and web tools for small businesses, nonprofits, and local government teams. One to two clients at a time, clear scopes, plain language."
>
  <!-- Hero -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-text">
        <h1 class="sr-only">Data & AI solutions for small organizations — AiCraft</h1>
        <p class="eyebrow">Data & AI consultancy</p>
        <p class="hero-subtitle">
          I help small businesses, local governments, and nonprofits design <span class="grad-text">AI agents and dynamic workflows</span> that automate the busywork&mdash;while keeping people in control of the decisions that matter.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="button button--primary">Talk about your idea</a>
          <a href="/services" class="button button--secondary">Explore services</a>
        </div>
        <p class="hero-subtext">A short call to see which workflow an AI agent could take off your plate.</p>
      </div>

      <!-- Static gradient composition holding an agentic-workflow node graph -->
      <div class="hero-composition" aria-hidden="true">
        <div class="comp-blob comp-blob--1"></div>
        <div class="comp-blob comp-blob--2"></div>
        <div class="comp-card comp-card--back"></div>
        <div class="comp-card comp-card--front">
          <svg class="comp-graph" viewBox="0 0 288 200" role="presentation" focusable="false">
            <defs>
              <linearGradient id="edgeGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" class="stop-teal" />
                <stop offset="1" class="stop-indigo" />
              </linearGradient>
              <linearGradient id="nodeGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" class="stop-teal" />
                <stop offset="1" class="stop-indigo" />
              </linearGradient>
            </defs>

            <!-- edges: work flowing trigger → agent → tools → human gate -->
            <path class="comp-edge" d="M46,84 L87,84" />
            <path class="comp-edge comp-edge--2" d="M121,84 C152,84 156,38 170,38" />
            <path class="comp-edge comp-edge--3" d="M121,84 C152,84 156,130 170,130" />
            <path class="comp-edge comp-edge--4" d="M194,38 C224,38 222,84 228,84" />
            <path class="comp-edge comp-edge--5" d="M194,130 C224,130 222,84 228,84" />

            <!-- trigger -->
            <circle class="comp-node" cx="34" cy="84" r="12" />
            <circle class="comp-node-dot" cx="34" cy="84" r="3.5" />
            <text class="comp-label" x="34" y="112">Request</text>

            <!-- tool / data nodes the agent calls -->
            <circle class="comp-node" cx="182" cy="38" r="12" />
            <circle class="comp-node-dot" cx="182" cy="38" r="3.5" />
            <text class="comp-label" x="182" y="18">Search</text>
            <circle class="comp-node" cx="182" cy="130" r="12" />
            <circle class="comp-node-dot" cx="182" cy="130" r="3.5" />
            <text class="comp-label" x="182" y="156">Data</text>

            <!-- central agent (pulsing) -->
            <circle class="comp-pulse" cx="104" cy="84" r="18" />
            <circle class="comp-node comp-node--agent" cx="104" cy="84" r="17" />
            <circle class="comp-agent-dot" cx="104" cy="84" r="4.5" />
            <text class="comp-label comp-label--agent" x="104" y="118">AI agent</text>

            <!-- human-in-the-loop gate -->
            <circle class="comp-node comp-node--human" cx="240" cy="84" r="14" />
            <path class="comp-check" d="M234,84 l4,4 l7,-8" />
            <text class="comp-label comp-label--human" x="254" y="116">You approve</text>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <div class="band band--sunrise" aria-hidden="true"></div>

  <!-- Proof strip -->
  <section class="proof-strip">
    <div class="container proof-strip__inner">
      <div class="proof-item">
        <strong class="proof-item__strong">25+ years in AI & data</strong>
        <span class="proof-item__clarifier">From enterprise intelligence to small nonprofits</span>
      </div>
      <div class="proof-item">
        <strong class="proof-item__strong">Federal-grade AI systems</strong>
        <span class="proof-item__clarifier">Enterprise knowledge retrieval & language AI</span>
      </div>
      <div class="proof-item">
        <strong class="proof-item__strong">2-3 clients per quarter</strong>
        <span class="proof-item__clarifier">Focused engagement</span>
      </div>
      <div class="proof-item">
        <strong class="proof-item__strong">You own everything</strong>
        <span class="proof-item__clarifier">Code, data, documentation—all yours</span>
      </div>
    </div>
  </section>

  <!-- Who this is for -->
  <section class="section audience-section">
    <div class="container">
      <div class="audience-inner reveal">
        <p class="eyebrow">Who this is for</p>
        <h2 class="audience-heading">
          Built for small organizations that can't hire a full data department
        </h2>
        <p class="audience-body">
          If your operations live in spreadsheets, inboxes, and a simple website—but modern data,
          AI, and automation feel out of reach—you're exactly who I work with. I build lightweight tools that plug into your existing systems so you get real leverage without big platforms or long contracts.
        </p>
      </div>
    </div>
  </section>

  <div class="band band--tide" aria-hidden="true"></div>

  <!-- Services grid -->
  <section class="section services-section" id="services">
    <div class="container">
      <div class="section-heading-block reveal">
        <p class="eyebrow">Services</p>
        <h2 class="services-heading">From un-ordered data to clear decisions</h2>
        <p class="services-subheading">
          Together, we start small: one workflow, one report, or one decision that's painful today.
          Then we design and build around it—using modern tooling, but explained in plain language.
        </p>
      </div>
      <div class="service-grid">
        {services.map((service, i) => (
          <div class={`reveal reveal--delay-${i}${i === 0 ? ' service-grid__featured' : ''}`}>
            <ServiceCard {...service} />
          </div>
        ))}
      </div>
      <div class="services-link reveal">
        <a href="/services" class="button button--secondary">See full service details →</a>
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="section process-section">
    <div class="container process-inner">
      <div class="process-text reveal">
        <p class="eyebrow">How we work together</p>
        <h2 class="process-heading">A focused partner, not a big agency</h2>
        <p class="process-body">
          You get senior-level data science, information design, and AI expertise—but delivered
          like a small studio: depth over volume, clear scopes, and straightforward
          communication. No layers, no mystery.
        </p>
        <a href="/about" class="process-more">Learn more about me →</a>
      </div>
      <ol class="process-steps">
        <li class="process-step reveal">
          <span class="step-num">01</span>
          <div>
            <strong>Listen</strong>
            <p>I clarify your goals, constraints, and current tools—before suggesting anything.</p>
          </div>
        </li>
        <li class="process-step reveal">
          <span class="step-num">02</span>
          <div>
            <strong>Design</strong>
            <p>I sketch the smallest useful solution and walk you through it before we build.</p>
          </div>
        </li>
        <li class="process-step reveal">
          <span class="step-num">03</span>
          <div>
            <strong>Build & refine</strong>
            <p>I implement, ship quickly, then iterate based on real use—not assumptions.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Knowledge preview -->
  {recentPosts.length > 0 && (
    <section class="section knowledge-section">
      <div class="container">
        <div class="knowledge-header reveal">
          <div>
            <p class="eyebrow">Knowledge</p>
            <h2 class="knowledge-heading">Distilled insights</h2>
          </div>
          <a href="/knowledge" class="button button--secondary knowledge-all-link">All articles →</a>
        </div>
        <div class="knowledge-grid">
          {recentPosts.map((post, i) => (
            <div class={`reveal reveal--delay-${i}`}>
              <KnowledgeCard
                title={post.data.title}
                date={post.data.date}
                summary={post.data.summary}
                tags={post.data.tags}
                href={`/knowledge/${post.slug}`}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="band band--dusk" aria-hidden="true"></div>

  <!-- CTA band -->
  <section class="cta-band section">
    <div class="container cta-band__inner reveal">
      <div>
        <p class="eyebrow">Let's talk</p>
        <h2 class="cta-band__heading">Ready to put your data to work?</h2>
        <p class="cta-band__body">
          Share a bit about your team and the decisions you're trying to improve, and I'll
          propose a small, concrete project we can deliver in weeks—not months.
        </p>
      </div>
      <a href="/contact" class="button button--primary cta-band__btn">Start a project</a>
    </div>
  </section>
</Layout>

<script>
  // ── Scroll reveal ──────────────────────────────────────────────────────────
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => {
    const delay = el.classList.contains('reveal--delay-1') ? 80
      : el.classList.contains('reveal--delay-2') ? 160
      : el.classList.contains('reveal--delay-3') ? 240
      : 0;
    (el as HTMLElement).style.transitionDelay = `${delay}ms`;
    observer.observe(el);
  });
</script>

<style>
  /* ── Screen-reader only ── */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Hero ── */
  .hero-section {
    padding-block: clamp(56px, 10vw, 120px);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  /* Eyebrow as an accent badge */
  .hero-text .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    padding: 0.3rem 0.75rem;
    background: rgba(217, 170, 82, 0.12);
    border: 1px solid rgba(217, 170, 82, 0.35);
    border-radius: 100px;
    font-size: 0.8125rem;
    color: var(--color-ink);
    letter-spacing: 0.05em;
  }

  .hero-subtitle {
    margin: 0 0 2.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.45;
    letter-spacing: -0.02em;
    max-width: 26ch;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .hero-subtext {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  /* ── Hero composition (static base + one-time bar-grow accent) ── */
  .hero-composition {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 400px;
    justify-self: center;
  }

  .comp-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(34px);
    opacity: 0.5;
    animation: blob-drift 14s ease-in-out infinite alternate;
  }
  .comp-blob--1 {
    width: 65%; height: 65%; top: -8%; right: -6%;
    background: radial-gradient(circle, var(--color-coral), transparent 70%);
  }
  .comp-blob--2 {
    width: 60%; height: 60%; bottom: -6%; left: -8%;
    background: radial-gradient(circle, var(--color-indigo), transparent 70%);
    animation-delay: -7s;
  }

  .comp-card {
    position: absolute;
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(28, 28, 28, 0.18);
  }
  .comp-card--back {
    inset: 16% 10% 20% 18%;
    background: var(--grad-tide);
    transform: rotate(-6deg);
  }
  .comp-card--front {
    inset: 20% 8% 16% 6%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: grid;
    place-items: center;
    padding: 9%;
  }

  /* ── Agentic workflow node graph ── */
  .comp-graph {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* gradient stops (var() resolves in CSS, not in SVG attributes) */
  .stop-teal   { stop-color: var(--color-teal); }
  .stop-indigo { stop-color: var(--color-indigo); }

  /* edges: dashed strokes with "data" flowing along the path */
  .comp-edge {
    fill: none;
    stroke: url(#edgeGrad);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 5 7;
    opacity: 0.85;
    animation: edge-flow 2.4s linear infinite;
  }
  .comp-edge--2 { animation-delay: -0.5s; }
  .comp-edge--3 { animation-delay: -1s; }
  .comp-edge--4 { animation-delay: -1.5s; }
  .comp-edge--5 { animation-delay: -2s; }

  @keyframes edge-flow {
    to { stroke-dashoffset: -24; }
  }

  /* nodes */
  .comp-node {
    fill: var(--color-surface);
    stroke: var(--color-indigo);
    stroke-width: 2;
  }
  .comp-node-dot { fill: var(--color-teal); }

  .comp-node--agent {
    fill: url(#nodeGrad);
    stroke: none;
  }
  .comp-agent-dot { fill: var(--color-surface); }

  .comp-node--human {
    fill: var(--color-accent);
    stroke: none;
  }
  .comp-check {
    fill: none;
    stroke: var(--color-panel-dark);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* node labels — carry the trigger → agent → tools → human story */
  .comp-label {
    fill: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-anchor: middle;
  }
  .comp-label--agent {
    fill: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 9.5px;
  }
  .comp-label--human { fill: var(--color-ink); }

  /* pulsing ring around the central agent = "the agent is working" */
  .comp-pulse {
    fill: none;
    stroke: var(--color-coral);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    animation: node-pulse 2.4s var(--ease-standard) infinite;
  }
  @keyframes node-pulse {
    0%   { transform: scale(0.75); opacity: 0.75; }
    70%  { transform: scale(1.5); opacity: 0; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  @keyframes blob-drift {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(4%, -5%) scale(1.06); }
  }

  /* ── Proof strip ── */
  .proof-strip {
    border-bottom: 1px solid var(--color-border);
    padding-block: 2.5rem;
    background: rgba(255, 255, 255, 0.4);
  }

  .proof-strip__inner {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .proof-item {
    border-left: 2px solid var(--color-accent);
    padding-left: 1rem;
    flex: 1 1 160px;
  }

  .proof-item__strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    font-family: var(--font-display);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .proof-item__clarifier {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    margin-top: 0.2rem;
    line-height: 1.4;
  }

  /* ── Audience section ── */
  .audience-inner {
    max-width: 680px;
  }

  .audience-heading {
    margin: 0 0 1.25rem;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    color: var(--color-ink);
    line-height: 1.15;
  }

  .audience-body {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  /* ── Services section ── */
  .services-section {
    background: linear-gradient(180deg, var(--color-tint), var(--color-bg));
  }

  .section-heading-block {
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .services-heading {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    color: var(--color-ink);
    line-height: 1.08;
  }

  .services-subheading {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .service-grid__featured {
    grid-column: 1 / -1;
  }

  .service-grid__featured :global(.service-card) {
    border-left: 3px solid var(--color-accent);
    padding: 2.25rem 2.5rem 2.5rem;
  }

  .service-grid__featured :global(.service-card__title) {
    font-size: 1.5rem;
  }

  .service-grid__featured :global(.service-card__description) {
    max-width: 64ch;
  }

  .services-link {
    margin-top: 2rem;
  }

  /* ── Process section ── */
  .process-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .process-heading {
    margin: 0 0 1rem;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    color: var(--color-ink);
    line-height: 1.15;
  }

  .process-body {
    margin: 0 0 1.5rem;
    font-size: 1.0625rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  .process-more {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    opacity: 1 !important;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .process-more:hover { opacity: 0.65 !important; }

  .process-steps {
    margin: 0; padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .process-step {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .process-step:first-child { border-top: 1px solid var(--color-border); }

  .step-num {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-ink-soft);
    flex-shrink: 0;
    padding-top: 2px;
    min-width: 1.75rem;
  }

  .process-step strong {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
  }

  .process-step p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
  }

  /* ── Knowledge section ── */
  .knowledge-section {
    background: linear-gradient(180deg, var(--color-bg), var(--color-tint));
  }

  .knowledge-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .knowledge-heading {
    margin: 0;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    color: var(--color-ink);
    line-height: 1.15;
  }

  .knowledge-all-link { flex-shrink: 0; }

  .knowledge-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* ── CTA band ── */
  .cta-band {
    background: var(--color-panel-dark);
    color: #ffffff;
  }

  .cta-band .eyebrow { color: rgba(255, 255, 255, 0.55); }

  .cta-band__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-band__heading {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
    color: #ffffff;
    max-width: 18ch;
  }

  .cta-band__body {
    margin: 0;
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.65);
    max-width: 42ch;
