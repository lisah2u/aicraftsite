---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import KnowledgeCard from '../components/KnowledgeCard.astro';
import { Image } from 'astro:assets';
import graphConcept from '../assets/graph-concept.png';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('knowledge', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const services = [
  {
    number: '01',
    title: 'Workflow Automation',
    description:
      'The repetitive, multi-step work that eats your week—intake, routing, follow-ups, data entry—handled end to end, with human approval gates at the moments that actually need judgment.',
    tags: ['Process automation', 'Human-in-the-loop', 'Integrations'],
    href: '/services#automation',
  },
  {
    number: '02',
    title: 'Search & Knowledge Retrieval',
    description:
      "Hybrid search that combines keyword precision with semantic understanding, so people find what they meant—not just what they typed. Built for organizations whose records span spreadsheets, documents, and archives.",
    tags: ['Hybrid search', 'Semantic retrieval', 'Structured + unstructured'],
    href: '/services#search',
  },
  {
    number: '03',
    title: 'Dashboards & Decision Tools',
    description:
      'Focused views built around the questions your team actually asks, replacing hours of manual spreadsheet reporting each week.',
    tags: ['Data visualization', 'Grants & programs', 'Visual reporting'],
    href: '/services#dashboards',
  },
  {
    number: '04',
    title: 'Data & AI Strategy',
    description:
      "Frame the right problem before touching code. Sometimes the answer is AI. Often it's better structure, a clearer process, or a simpler tool—and I'll tell you which.",
    tags: ['Problem framing', 'Analysis of alternatives', 'Information architecture'],
    href: '/services#strategy',
  },
  {
    number: '05',
    title: 'Connected Web Presence',
    description:
      'Your website as a live data application, not a static brochure. Forms that write to your systems, and features grounded in your own content.',
    tags: ['Modern web frameworks', 'Forms & integrations', 'Content architecture'],
    href: '/services#web',
  },
  {
    number: '06',
    title: 'Agentic AI — when it’s warranted',
    description:
      'I build AI agents that carry out multi-step processes on your behalf. It just isn’t the first thing I reach for. When a process genuinely needs one, you get an agent designed with guardrails, logging, and evaluation.',
    tags: ['Agent frameworks', 'Guardrails & logging', 'Evaluation'],
    href: '/services#agents',
  },
];
---

<Layout
  title="AiCraft — AI-Powered Data Solutions for Small Organizations"
  description="AiCraft builds intelligence-grade AI, data, and web tools for small businesses, nonprofits, and local government teams. One to two clients at a time, clear scopes, plain language."
>
  <!-- Hero -->
  <section class="hero-section">
    <!-- Node-graph artwork, right-anchored and dissolved into the cream.
         multiply drops the artwork's white background against --color-bg. -->
    <div class="hero-backdrop" aria-hidden="true">
      <Image
        src={graphConcept}
        alt=""
        widths={[600, 900, 1200]}
        sizes="(max-width: 720px) 100vw, 55vw"
        quality={70}
        loading="eager"
        class="hero-backdrop__img"
      />
    </div>

    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Data & AI consultancy</p>
        <h1 class="hero-title">Automate the work that eats your week.</h1>
        <p class="hero-subtitle">
          I help small businesses, local governments, and nonprofits <span class="grad-text">automate repetitive work</span>&mdash;and actually find what&rsquo;s buried in their records. Tailored to how your team already works, and built so you can keep it running.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="button button--primary">Talk about your idea</a>
          <a href="/services" class="button button--secondary">Explore services</a>
        </div>
        <p class="hero-subtext">A short call to find the one workflow worth automating first.</p>
      </div>
    </div>
  </section>

  <div class="band band--sunrise" aria-hidden="true"></div>

  <!-- Proof strip -->
  <section class="proof-strip">
    <div class="container proof-strip__inner">
      <div class="proof-item">
        <strong class="proof-item__strong">25+ years in AI & data</strong>
        <span class="proof-item__clarifier">From enterprise intelligence to small nonprofits</span>
      </div>
      <div class="proof-item">
        <strong class="proof-item__strong">Federal-grade AI systems</strong>
        <span class="proof-item__clarifier">Enterprise knowledge retrieval & language AI</span>
      </div>
      <div class="proof-item">
        <strong class="proof-item__strong">2-3 clients per quarter</strong>
        <span class="proof-item__clarifier">Focused engagement</span>
      </div>
      <div class="proof-item">
        <strong class="proof-item__strong">You own everything</strong>
        <span class="proof-item__clarifier">Code, data, documentation—all yours</span>
      </div>
    </div>
  </section>

  <!-- Who this is for -->
  <section class="section audience-section">
    <div class="container">
      <div class="audience-inner reveal">
        <p class="eyebrow">Who this is for</p>
        <h2 class="audience-heading">
          Built for small organizations that can't hire a full data department
        </h2>
        <p class="audience-body">
          If your operations live in spreadsheets, inboxes, and a simple website—but modern data,
          AI, and automation feel out of reach—you're exactly who I work with. I build lightweight
          tools that plug into your existing systems so you get real leverage without big platforms
          or long contracts.
        </p>
        <p class="audience-body audience-body--stance">
          I build agentic AI. It's just rarely the first thing I reach for. A small team needs a
          solution that's tailored, sustainable, and cheap to keep running—usually that means a
          well-built automation and search that actually finds things. When a process genuinely
          needs an agent, I build that too.
        </p>
      </div>
    </div>
  </section>

  <div class="band band--tide" aria-hidden="true"></div>

  <!-- Services grid -->
  <section class="section services-section" id="services">
    <div class="container">
      <div class="section-heading-block reveal">
        <p class="eyebrow">Services</p>
        <h2 class="services-heading">From un-ordered data to clear decisions</h2>
        <p class="services-subheading">
          Together, we start small: one workflow, one report, or one decision that's painful today.
          Then we design and build around it—using modern tooling, but explained in plain language.
        </p>
      </div>
      <div class="service-grid">
        {services.map((service, i) => (
          <div class={`reveal reveal--delay-${i}${i === 0 ? ' service-grid__featured' : ''}${i === services.length - 1 ? ' service-grid__aside' : ''}`}>
            <ServiceCard {...service} />
          </div>
        ))}
      </div>
      <div class="services-link reveal">
        <a href="/services" class="button button--secondary">See full service details →</a>
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="section process-section">
    <div class="container process-inner">
      <div class="process-text reveal">
        <p class="eyebrow">How we work together</p>
        <h2 class="process-heading">A focused partner, not a big agency</h2>
        <p class="process-body">
          You get senior-level data science, information design, and AI expertise—but delivered
          like a small studio: depth over volume, clear scopes, and straightforward
          communication. No layers, no mystery.
        </p>
        <a href="/about" class="process-more">Learn more about me →</a>
      </div>
      <ol class="process-steps">
        <li class="process-step reveal">
          <span class="step-num">01</span>
          <div>
            <strong>Listen</strong>
            <p>I clarify your goals, constraints, and current tools—before suggesting anything.</p>
          </div>
        </li>
        <li class="process-step reveal">
          <span class="step-num">02</span>
          <div>
            <strong>Design</strong>
            <p>I sketch the smallest useful solution and walk you through it before we build.</p>
          </div>
        </li>
        <li class="process-step reveal">
          <span class="step-num">03</span>
          <div>
            <strong>Build & refine</strong>
            <p>I implement, ship quickly, then iterate based on real use—not assumptions.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Knowledge preview -->
  {recentPosts.length > 0 && (
    <section class="section knowledge-section">
      <div class="container">
        <div class="knowledge-header reveal">
          <div>
            <p class="eyebrow">Knowledge</p>
            <h2 class="knowledge-heading">Distilled insights</h2>
          </div>
          <a href="/knowledge" class="button button--secondary knowledge-all-link">All articles →</a>
        </div>
        <div class="knowledge-grid">
          {recentPosts.map((post, i) => (
            <div class={`reveal reveal--delay-${i}`}>
              <KnowledgeCard
                title={post.data.title}
                date={post.data.date}
                summary={post.data.summary}
                tags={post.data.tags}
                href={`/knowledge/${post.slug}`}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="band band--dusk" aria-hidden="true"></div>

  <!-- CTA band -->
  <section class="cta-band section">
    <div class="container cta-band__inner reveal">
      <div>
        <p class="eyebrow">Let's talk</p>
        <h2 class="cta-band__heading">Ready to put your data to work?</h2>
        <p class="cta-band__body">
          Share a bit about your team and the decisions you're trying to improve, and I'll
          propose a small, concrete project we can deliver in weeks—not months.
        </p>
      </div>
      <a href="/contact" class="button button--primary cta-band__btn">Start a project</a>
    </div>
  </section>
</Layout>

<script>
  // ── Scroll reveal ──────────────────────────────────────────────────────────
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => {
    const delay = el.classList.contains('reveal--delay-1') ? 80
      : el.classList.contains('reveal--delay-2') ? 160
      : el.classList.contains('reveal--delay-3') ? 240
      : 0;
    (el as HTMLElement).style.transitionDelay = `${delay}ms`;
    observer.observe(el);
  });
</script>

<style>
  /* ── Hero ── */
  .hero-section {
    position: relative;
    overflow: hidden;
    padding-block: clamp(56px, 10vw, 120px);
    border-bottom: 1px solid var(--color-border);
  }

  /* Node-graph artwork bleeding off the right edge.
     multiply against the cream bg erases the artwork's white plate;
     the mask dissolves it before it reaches the text column. */
  .hero-backdrop {
    position: absolute;
    inset: 0 0 0 auto;
    width: 58%;
    z-index: 0;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 40%, rgba(0, 0, 0, 0.3) 68%, rgba(0, 0, 0, 1) 100%);
    mask-image: linear-gradient(to right, transparent 0%, transparent 40%, rgba(0, 0, 0, 0.3) 68%, rgba(0, 0, 0, 1) 100%);
  }

  .hero-backdrop__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    max-width: 62ch;
  }

  /* Eyebrow as an accent badge */
  .hero-text .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    padding: 0.3rem 0.75rem;
    background: rgba(217, 170, 82, 0.12);
    border: 1px solid rgba(217, 170, 82, 0.35);
    border-radius: 100px;
    font-size: 0.8125rem;
    color: var(--color-ink);
    letter-spacing: 0.05em;
  }

  .hero-title {
    margin: 0 0 1.5rem;
    font-size: clamp(2.5rem, 5.6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--color-ink);
    max-width: 15ch;
  }

  .hero-subtitle {
    margin: 0 0 2.25rem;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    font-weight: 400;
    color: var(--color-ink-soft);
    line-height: 1.65;
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .hero-subtext {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  /* ── Proof strip ── */
  .proof-strip {
    border-bottom: 1px solid var(--color-border);
    padding-block: 2.5rem;
    background: rgba(255, 255, 255, 0.4);
  }

  .proof-strip__inner {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .proof-item {
    border-left: 2px solid var(--color-accent);
    padding-left: 1rem;
    flex: 1 1 160px;
  }

  .proof-item__strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    font-family: var(--font-display);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .proof-item__clarifier {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    margin-top: 0.2rem;
    line-height: 1.4;
  }

  /* ── Audience section ── */
  .audience-inner {
    max-width: 680px;
  }

  .audience-heading {
    margin: 0 0 1.25rem;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    color: var(--color-ink);
    line-height: 1.15;
  }

  .audience-body {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  /* the "I build agents, I just don't lead with them" position */
  .audience-body--stance {
    margin-top: 1.5rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-accent);
    color: var(--color-ink);
  }

  /* ── Services section ── */
  .services-section {
    background: linear-gradient(180deg, var(--color-tint), var(--color-bg));
  }

  .section-heading-block {
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .services-heading {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    color: var(--color-ink);
    line-height: 1.08;
  }

  .services-subheading {
    margin: 0;
    font-size: 1.0625rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .service-grid__featured {
    grid-column: 1 / -1;
  }

  .service-grid__featured :global(.service-card) {
    border-left: 3px solid var(--color-accent);
    padding: 2.25rem 2.5rem 2.5rem;
  }

  .service-grid__featured :global(.service-card__title) {
    font-size: 1.5rem;
  }

  .service-grid__featured :global(.service-card__description) {
    max-width: 64ch;
  }

  /* Agentic AI spans the last row, but deliberately reads quieter than the
     rest — it's the capability we hold in reserve, not the one we sell. */
  .service-grid__aside {
    grid-column: 1 / -1;
  }

  .service-grid__aside :global(.service-card) {
    background: transparent;
    border-style: dashed;
  }

  .service-grid__aside :global(.service-card__description) {
    max-width: 64ch;
  }

  .services-link {
    margin-top: 2rem;
  }

  /* ── Process section ── */
  .process-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .process-heading {
    margin: 0 0 1rem;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    color: var(--color-ink);
    line-height: 1.15;
  }

  .process-body {
    margin: 0 0 1.5rem;
    font-size: 1.0625rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  .process-more {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    opacity: 1 !important;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .process-more:hover { opacity: 0.65 !important; }

  .process-steps {
    margin: 0; padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .process-step {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .process-step:first-child { border-top: 1px solid var(--color-border); }

  .step-num {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-ink-soft);
    flex-shrink: 0;
    padding-top: 2px;
    min-width: 1.75rem;
  }

  .process-step strong {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
  }

  .process-step p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
  }

  /* ── Knowledge section ── */
  .knowledge-section {
    background: linear-gradient(180deg, var(--color-bg), var(--color-tint));
  }

  .knowledge-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .knowledge-heading {
    margin: 0;
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    color: var(--color-ink);
    line-height: 1.15;
  }

  .knowledge-all-link { flex-shrink: 0; }

  .knowledge-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* ── CTA band ── */
  .cta-band {
    background: var(--color-panel-dark);
    color: #ffffff;
  }

  .cta-band .eyebrow { color: rgba(255, 255, 255, 0.55); }

  .cta-band__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-band__heading {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
    color: #ffffff;
    max-width: 18ch;
  }

  .cta-band__body {
    margin: 0;
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.65);
    max-width: 42ch;
    line-height: 1.65;
  }

  .cta-band__btn {
    background: var(--color-accent);
    color: var(--color-panel-dark);
    flex-shrink: 0;
    align-self: center;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .knowledge-grid    { grid-template-columns: repeat(2, 1fr); }
    .process-inner     { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  /* Laptop range: the text column and the artwork start to compete for the
     same space, so pull the artwork back rather than let it crowd the copy. */
  @media (max-width: 1100px) {
    .hero-backdrop {
      width: 46%;
      opacity: 0.4;
    }
  }

  /* Text reflows to full width here, so the artwork has to recede
     rather than sit underneath the headline. */
  @media (max-width: 720px) {
    .hero-backdrop {
      width: 100%;
      opacity: 0.15;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 60%, rgba(0, 0, 0, 1) 100%);
      mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 60%, rgba(0, 0, 0, 1) 100%);
    }
  }

  @media (max-width: 640px) {
    .service-grid      { grid-template-columns: 1fr; }
    .knowledge-grid    { grid-template-columns: 1fr; }
    .knowledge-header  { flex-direction: column; align-items: flex-start; }
    .cta-band__inner   { flex-direction: column; align-items: flex-start; }
    .proof-strip__inner { gap: 1.5rem; }
    .proof-item        { flex: 1 1 calc(50% - 1.5rem); }
  }
</style>
